{
  "name": "testing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "node --test scripts/fetch-contributions.test.mjs",
    "smoke": "vite build --ssr scripts/smoke.mjs --outDir .smoke --logLevel warn && node .smoke/smoke.js",
    "contrib": "node --env-file-if-exists=.env scripts/fetch-contributions.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/server-renderer": "^3.5.44",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
